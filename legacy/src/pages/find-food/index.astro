---
import FindFoodLayout from "../../components/find-food/FindFoodLayout.astro";
import FindFoodResourceSection from "../../components/find-food/FindFoodResourceSection.astro";
import FindFoodCalendarSection from "../../components/find-food/FindFoodCalendarSection.astro";
import FindFoodLemontreeSection from "../../components/find-food/FindFoodLemontreeSection.astro";
import { fetchProfiles } from "../../lib/find-food/api";

const profiles = await fetchProfiles();

const title = "Find Food: Local Distributions + Pop-ups | Sharing Excess";
const description =
  "Looking for fresh, free groceries near you? We partner with local organizations and businesses to bring rescued produce directly to the community - no sign-up or ID required.All events are free and open to the public.";
const canonical = new URL("/find-food", Astro.site).href;
---

<FindFoodLayout
  title={title}
  description={description}
  canonical={canonical}
  includeMapbox={true}>
  <FindFoodResourceSection profiles={profiles} />
  <FindFoodCalendarSection />
  <FindFoodLemontreeSection />
</FindFoodLayout>
