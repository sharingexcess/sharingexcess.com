---
import SiteHead from "../components/layout/SiteHead.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SurplusApiOrigin from "../components/layout/SurplusApiOrigin.astro";
import "../styles/tailwind.css";

const TRUCKLOAD_AMOUNT = 1750;
const truckloadAmountLabel = TRUCKLOAD_AMOUNT.toLocaleString("en-US");
const pageTitle = "Sponsor a Truckload of Food | Sharing Excess";
const description = `For $${truckloadAmountLabel}, you can pay the cost to move one truckload of rescued food. Each load is more than 35,000 pounds, about a month of groceries for 80 families.`;
const canonical = new URL("/sponsor-a-truck", Astro.site).href;
const headerImage = "/images/53795236385_30b4365f56_k.jpg";
const truckFormHref = `/sponsor-a-truck?form=FUNKDABHTGG&amount=${TRUCKLOAD_AMOUNT}&modifyAmount=no`;
---

<!doctype html>
<html data-wf-site="67d1d2d9c708819c5185d49c" lang="en">
  <head>
    <SurplusApiOrigin />
    <script
      src="https://js.sentry-cdn.com/d73e9e40eaf6f191cb6758409bebcaa4.min.js"
      crossorigin="anonymous"></script>
    <script is:inline>
      Sentry.onLoad(function () {
        var isProduction =
          window.location.hostname === "sharingexcess.com" ||
          window.location.hostname === "www.sharingexcess.com";
        Sentry.init({
          env: isProduction ? "production" : "staging",
          autoSessionTracking: true,
          tracesSampleRate: 1.0,
          replaysSessionSampleRate: isProduction ? 0.1 : 1.0,
          replaysOnErrorSampleRate: 1.0,
          ignoreErrors: ["Script error.", "ResizeObserver loop", /webkit\.messageHandlers/],
          denyUrls: [/extensions\//i, /^chrome:\/\//i],
        });
      });
    </script>
    <SiteHead title={pageTitle} description={description} canonical={canonical} />
  </head>
  <body>
    <SiteHeader />

    <PageHeader
      title="Sponsor a Truckload of Food"
      image={headerImage}
      imageAlt="Sharing Excess truck loaded with rescued produce"
    />

    <section class="section">
      <div class="content-container">
        <div class="_50-50-container">
          <div class="_50-50-child">
            <img
              src="/images/53773492941_9df87a59f9_k.jpg"
              loading="lazy"
              sizes="(max-width: 2048px) 100vw, 2048px"
              srcset="/images/53773492941_9df87a59f9_k-p-500.jpg 500w, /images/53773492941_9df87a59f9_k-p-800.jpg 800w, /images/53773492941_9df87a59f9_k-p-1080.jpg 1080w, /images/53773492941_9df87a59f9_k-p-1600.jpg 1600w, /images/53773492941_9df87a59f9_k-p-2000.jpg 2000w, /images/53773492941_9df87a59f9_k.jpg 2048w"
              alt="Rescued food prepared for delivery"
              class="_50-50-image green-decoration"
            />
          </div>
          <div class="_50-50-child">
            <h2 class="font-family-orbital margin-bottom-sm">
              <strong>Sponsor one truckload of rescued food</strong>
            </h2>
            <p class="color-black-64 margin-bottom-xl">
              {`A $${truckloadAmountLabel} gift covers pickup and delivery for one full truck. Each load is more than 35,000 pounds, about a month of groceries for 80 families.`}
              <br />
              The food is donated by wholesale partners. Your gift pays for the trucks, drivers, and
              refrigerated runs that get it to pantries, shelters, and distribution sites while it is
              still fresh.
            </p>
            <a
              data-mixpanel-component="nav_donate_button"
              href={truckFormHref}
              class="button w-inline-block"
              ><img loading="lazy" src="/images/hand-heart-icon.svg" alt="" class="icon-lg" />
              <div>Sponsor a Truckload</div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="section background-green">
      <div class="content-container flex column align-items-center gap-2xl">
        <div class="flex column align-items-center width-100">
          <h4 class="eyebrow color-green-tertiary margin-bottom-lg">HOW IT WORKS</h4>
          <h2 class="color-white margin-bottom-lg text-align-center">What happens after you give</h2>
          <p class="max-width-720 text-align-center color-white-64">
            Your gift pays for drivers, fuel, and refrigerated runs from our wholesale partners to the
            local organizations that hand food out in their neighborhoods.
          </p>
        </div>
        <div class="flex row mobile-column gap-xl width-100">
          <div class="hover-animation-card retail-background-image">
            <div class="hover-animation-card-content">
              <h4 class="color-white">1. You sponsor a truck</h4>
              <p class="color-white font-size-sm">
                The food is always donated. Your gift covers the cost to pick it up and deliver it.
              </p>
            </div>
          </div>
          <div class="hover-animation-card wholesale-background-image">
            <div class="hover-animation-card-content">
              <h4 class="color-white">2. We pick up surplus food</h4>
              <p class="color-white font-size-sm">
                Our teams collect food from produce wholesalers, farms, and large food businesses that
                have more than they can sell.
              </p>
            </div>
          </div>
          <div class="hover-animation-card direct-link-background-image">
            <div class="hover-animation-card-content">
              <h4 class="color-white">3. Partners distribute it locally</h4>
              <p class="color-white font-size-sm">
                Food banks, pantries, shelters, and other partners in our network receive the delivery and
                share it with the families they serve.
              </p>
            </div>
          </div>
        </div>
        <div
          class="center-block background-white text-align-center border-radius-lg padding-x-lg padding-y-xl max-width-720">
          <h4 class="margin-bottom-sm">Share what your truckload supported</h4>
          <p>
            After you give, we email you a graphic you can post or forward so friends and family can see
            what your gift moved.
          </p>
        </div>
      </div>
    </div>

    <div class="section background-black">
      <div class="content-container">
        <div class="_50-50-container">
          <div class="_50-50-child">
            <img
              src="/images/53773492941_9df87a59f9_k.jpg"
              loading="lazy"
              sizes="(max-width: 2048px) 100vw, 2048px"
              srcset="/images/53773492941_9df87a59f9_k-p-500.jpg 500w, /images/53773492941_9df87a59f9_k-p-800.jpg 800w, /images/53773492941_9df87a59f9_k-p-1080.jpg 1080w, /images/53773492941_9df87a59f9_k-p-1600.jpg 1600w, /images/53773492941_9df87a59f9_k-p-2000.jpg 2000w, /images/53773492941_9df87a59f9_k.jpg 2048w"
              alt="Volunteers sorting rescued produce for delivery"
              class="_50-50-image green-decoration"
            />
          </div>
          <div class="_50-50-child">
            <h4 class="eyebrow color-green-secondary margin-bottom-lg">WHY SPONSOR A TRUCKLOAD?</h4>
            <h2 class="color-white margin-bottom-lg">Your gift pays for trucks, not groceries</h2>
            <p class="color-white-80 margin-bottom-2xl">
              Every pound we move is donated. We spend your dollars on logistics so surplus food reaches
              pantries, shelters, and community partners instead of landfills. One truckload is more than
              35,000 pounds of fresh food for the families those partners serve.
            </p>
            <a
              data-mixpanel-component="nav_donate_button"
              href={truckFormHref}
              class="button secondary-white w-inline-block">
              <div>{`Sponsor a truckload for $${truckloadAmountLabel}`}</div>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="content-container">
        <div class="center-block">
          <h2 class="text-align-center">More ways to donate:</h2>
          <div
            class="w-layout-grid flex row justify-center align-items-center gap-lg wrap margin-bottom-2xl">
            <a
              href="https://account.venmo.com/u/sharingexcess"
              target="_blank"
              rel="noopener noreferrer"
              class="link-block-3 w-inline-block"
              ><img
                class="image-10 no-margin"
                src="/images/Venmo-Symbol.png"
                alt="Venmo"
                data-mixpanel-component-id="venmo"
                data-mixpanel-component="logo_sponsor_truck_page_more_ways_to_donate"
                loading="lazy"
                srcset="/images/Venmo-Symbol.avif 500w, /images/Venmo-Symbol.png 3840w" /></a
            >
            <a
              href="https://www.paypal.com/paypalme/sharingexcess"
              target="_blank"
              rel="noopener noreferrer"
              class="link-block-3 w-inline-block"
              ><img
                class="image-10 no-margin"
                src="/images/PayPal-Logo.png"
                alt="PayPal"
                data-mixpanel-component-id="paypal"
                data-mixpanel-component="logo_sponsor_truck_page_more_ways_to_donate"
                loading="lazy"
                srcset="/images/PayPal-Logo.avif 500w, /images/PayPal-Logo.avif 800w, /images/PayPal-Logo-p-1080.png 1080w, /images/PayPal-Logo.png 3840w" /></a
            >
            <a
              href="https://cash.app/$SharingExcess"
              target="_blank"
              rel="noopener noreferrer"
              class="link-block-3 w-inline-block"
              ><img
                class="image-10 no-margin"
                src="/images/1660060378cash-app-symbols_1.avif"
                alt="Cash App"
                data-mixpanel-component-id="cash_app"
                data-mixpanel-component="logo_sponsor_truck_page_more_ways_to_donate"
                loading="lazy"
                srcset="/images/1660060378cash-app-symbols_11660060378cash-app-symbols.avif 500w, /images/1660060378cash-app-symbols_1.avif 2000w" /></a
            >
          </div>
        </div>
        <div class="flex mobile-column">
          <div
            class="center-block background-white text-align-center border-radius-lg padding-x-lg padding-y-lg">
            <h4 class="margin-bottom-sm">Donor Advised Funds</h4>
            <p>
              EIN 86-2161466<br />6700 Essington Ave, Suite E207, Philadelphia PA 19153
            </p>
          </div>
          <div
            class="center-block background-white text-align-center border-radius-lg padding-x-lg padding-y-lg">
            <h4 class="margin-bottom-sm">Send a Check</h4>
            <p>
              Payable to Sharing Excess and mail to 6700 Essington Ave, Suite E207, Philadelphia PA
              19153
            </p>
          </div>
          <div
            class="center-block background-white text-align-center border-radius-lg padding-x-lg padding-y-lg">
            <h4 class="margin-bottom-sm">Stock + Crypto</h4>
            <p>
              Vanguard Account No. 58625959, email <a href="mailto:donate@sharingexcess.com"
                >donate@sharingexcess.com</a
              > for crypto donation details
            </p>
          </div>
        </div>
      </div>
    </div>

    <SiteFooter />

    <script
      src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67d1d2d9c708819c5185d49c"
      type="text/javascript"
      integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
      crossorigin="anonymous"></script>
    <script src="/js/webflow.js" type="text/javascript"></script>
    <script defer src="/js/cookie-consent.js"></script>
    <script defer src="/js/header-scroll.js"></script>

    <style>
      .hover-animation-card-content {
        height: 56px;
        gap: 0;
      }

      .hover-animation-card-content p {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: opacity 0.24s ease-out, max-height 0.24s ease-out;
      }

      .hover-animation-card:hover .hover-animation-card-content {
        background-color: var(--black--black-64);
        height: 256px;
        gap: var(--space--lg);
      }

      .hover-animation-card:hover .hover-animation-card-content p {
        max-height: 180px;
        opacity: 1;
      }
    </style>
  </body>
</html>
