---
import type { CollectionEntry } from "astro:content";
import SiteHead from "../components/layout/SiteHead.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SurplusApiOrigin from "../components/layout/SurplusApiOrigin.astro";
import "../styles/tailwind.css";
import "../styles/blog.css";

interface Props {
  post: CollectionEntry<"blog">;
  readingTimeMinutes: number;
}

const { post, readingTimeMinutes } = Astro.props;
const { title, subtitle, description, pubDate, updatedDate, author, headerImage, headerImageAlt } =
  post.data;

const resolvedHeaderImage = headerImage ?? "/images/financials.jpg";

const pageTitle = subtitle ? `${title} | Sharing Excess` : `${title} | Sharing Excess`;
const canonical = new URL(`/blog/${post.id}`, Astro.site).href;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<!doctype html>
<html data-wf-site="67d1d2d9c708819c5185d49c" lang="en">
  <head>
    <SurplusApiOrigin />
    <script
      src="https://js.sentry-cdn.com/d73e9e40eaf6f191cb6758409bebcaa4.min.js"
      crossorigin="anonymous"></script>
    <script is:inline>
      Sentry.onLoad(function () {
        var isProduction =
          window.location.hostname === "sharingexcess.com" ||
          window.location.hostname === "www.sharingexcess.com";
        Sentry.init({
          env: isProduction ? "production" : "staging",
          autoSessionTracking: true,
          tracesSampleRate: 1.0,
          replaysSessionSampleRate: isProduction ? 0.1 : 1.0,
          replaysOnErrorSampleRate: 1.0,
          ignoreErrors: ["Script error.", "ResizeObserver loop", /webkit\.messageHandlers/],
          denyUrls: [/extensions\//i, /^chrome:\/\//i],
        });
      });
    </script>
    <SiteHead title={pageTitle} description={description} canonical={canonical} ogType="article" />
  </head>
  <body>
    <SiteHeader />

    <PageHeader title="Sharing Excess Blog" image={resolvedHeaderImage} imageAlt={headerImageAlt} />

    <main class="blog-page">
      <header class="blog-hero">
        <div class="blog-hero-inner">
          <p class="blog-eyebrow">Blog</p>
          <h1 class="blog-title">{title}</h1>
          {subtitle && <p class="blog-subtitle">{subtitle}</p>}
          <div class="blog-meta">
            <span>By {author.name}</span>
            <span class="blog-meta-divider" aria-hidden="true"></span>
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            <span class="blog-meta-divider" aria-hidden="true"></span>
            <span>{readingTimeMinutes} min read</span>
            {
              updatedDate && (
                <>
                  <span class="blog-meta-divider" aria-hidden="true" />
                  <span>
                    Updated <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>
                  </span>
                </>
              )
            }
          </div>
        </div>
      </header>

      <article class="blog-article">
        <div class="blog-article-inner">
          <div class="blog-prose">
            <slot />
          </div>

          <footer class="blog-author">
            <p class="blog-author-label">About the Author</p>
            <p class="blog-author-name">
              {
                author.url ? (
                  <a href={author.url} target="_blank" rel="noopener noreferrer">
                    {author.name}
                  </a>
                ) : (
                  author.name
                )
              }
            </p>
            {author.bio && <p class="blog-author-bio">{author.bio}</p>}
            {
              author.url && (
                <p class="blog-author-bio">
                  Learn more about his projects at{" "}
                  <a href={author.url} target="_blank" rel="noopener noreferrer">
                    {author.url.replace(/^https?:\/\//, "")}
                  </a>
                  .
                </p>
              )
            }
          </footer>
        </div>
      </article>
    </main>

    <SiteFooter />

    <script
      src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67d1d2d9c708819c5185d49c"
      type="text/javascript"
      integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
      crossorigin="anonymous"></script>
    <script src="/js/webflow.js" type="text/javascript"></script>
    <script defer src="/js/cookie-consent.js"></script>
    <script defer src="/js/header-scroll.js"></script>
  </body>
</html>
