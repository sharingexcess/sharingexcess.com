---
import SiteHead from "../layout/SiteHead.astro";
import SiteHeader from "../layout/SiteHeader.astro";
import PageHeader from "../layout/PageHeader.astro";
import SiteFooter from "../layout/SiteFooter.astro";
import SurplusApiOrigin from "../layout/SurplusApiOrigin.astro";
import "../../styles/tailwind.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  pageHeaderTitle?: string;
  pageHeaderImage?: string;
  pageHeaderImageAlt?: string;
  includeMapbox?: boolean;
}

const {
  title,
  description,
  canonical,
  pageHeaderTitle = "Find Food",
  pageHeaderImage = "/images/financials.jpg",
  pageHeaderImageAlt = "",
  includeMapbox = false,
} = Astro.props;
---

<!doctype html>
<html data-wf-site="67d1d2d9c708819c5185d49c" lang="en">
  <head>
    <SurplusApiOrigin />
    <script
      src="https://js.sentry-cdn.com/d73e9e40eaf6f191cb6758409bebcaa4.min.js"
      crossorigin="anonymous"></script>
    <script is:inline>
      Sentry.onLoad(function () {
        var isProduction =
          window.location.hostname === "sharingexcess.com" ||
          window.location.hostname === "www.sharingexcess.com";
        Sentry.init({
          env: isProduction ? "production" : "staging",
          autoSessionTracking: true,
          tracesSampleRate: 1.0,
          replaysSessionSampleRate: isProduction ? 0.1 : 1.0,
          replaysOnErrorSampleRate: 1.0,
          ignoreErrors: ["Script error.", "ResizeObserver loop", /webkit\.messageHandlers/],
          denyUrls: [/extensions\//i, /^chrome:\/\//i],
        });
      });
    </script>
    <SiteHead title={title} description={description} canonical={canonical} />
    {
      includeMapbox && (
        <>
          <link
            href="https://api.mapbox.com/mapbox-gl-js/v3.1.0/mapbox-gl.css"
            rel="stylesheet"
          />
          <script src="https://api.mapbox.com/mapbox-gl-js/v3.1.0/mapbox-gl.js"></script>
        </>
      )
    }
  </head>
  <body>
    <SiteHeader />
    <PageHeader title={pageHeaderTitle} image={pageHeaderImage} imageAlt={pageHeaderImageAlt} />
    <slot />
    <SiteFooter />
    <script
      src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=67d1d2d9c708819c5185d49c"
      type="text/javascript"
      integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
      crossorigin="anonymous"></script>
    <script src="/js/webflow.js" type="text/javascript"></script>
    <script defer src="/js/cookie-consent.js"></script>
    <script defer src="/js/impact-data.js"></script>
    <script defer src="/js/header-scroll.js"></script>
  </body>
</html>
