---
import { profilesToGeoJson } from "../../lib/find-food/geojson";
import type { PublicFindFoodProfile } from "../../lib/find-food/types";

interface Props {
  profile: PublicFindFoodProfile;
}

const { profile } = Astro.props;
const geojson = profilesToGeoJson([profile]);
---

<div class="find-food-profile-map">
  <div class="find-food-map-wrapper find-food-map-wrapper--preview">
    <div id="find-food-map"></div>
    <div id="find-food-map-loading" class="find-food-map-loading">
      <img src="/images/logo.png" alt="Loading map" width="80" />
    </div>
  </div>
</div>

<script define:vars={{ geojson }}>
  window.__FIND_FOOD_GEOJSON = geojson;
  window.__FIND_FOOD_MAP_PREVIEW = true;
</script>
<script defer src="/js/find-food-map.js"></script>
