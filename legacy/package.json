{
  "name": "@sharingexcess/legacy",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "start": "serve dist -l tcp://0.0.0.0:4321",
    "sync:webflow": "echo 'ERROR: sync:webflow is disabled — it deletes custom assets in public/ that are not in the Webflow export. Edit legacy/ and public/ directly, or run generate after a one-off Webflow export.' >&2 && exit 1",
    "generate": "bun ../scripts/migration/generate-webflow-astro.ts",
    "verify": "bun run build && bun ../scripts/migration/verify-build.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.59.1",
    "serve": "14"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "6.4.4",
    "linkedom": "^0.18.12",
    "tailwindcss": "3.4.17"
  }
}
