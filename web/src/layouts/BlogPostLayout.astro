---
import type { CollectionEntry } from "astro:content";
import PageLayout from "./PageLayout.astro";

interface Props {
  post: CollectionEntry<"blog">;
  readingTimeMinutes: number;
}

const { post, readingTimeMinutes } = Astro.props;
const { title, subtitle, description, pubDate, author } = post.data;

const pageTitle = `${title} | Sharing Excess`;
const canonical = new URL(`/blog/${post.id}`, Astro.site).href;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<PageLayout title={pageTitle} description={description} canonical={canonical}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-sm font-medium text-se-green">Blog</p>
    <h1 class="mt-2 text-4xl font-bold text-neutral-900">{title}</h1>
    {subtitle && <p class="mt-4 text-xl text-neutral-550">{subtitle}</p>}
    <p class="mt-6 text-sm text-neutral-500">
      {formattedDate} · {author.name} · {readingTimeMinutes} min read
    </p>
    <div class="prose prose-neutral mt-10 max-w-none">
      <slot />
    </div>
  </article>
</PageLayout>
