---
import PageLayout from "@/layouts/PageLayout.astro";
import HomeHero from "@/sections/HomeHero";
import DonationSection from "@/sections/DonationSection";
import LogosBannerSection from "@/sections/LogosBannerSection";
import MapSection from "@/sections/MapSection";
import SurplusSection from "@/sections/SurplusSection";
import SectionScrollHandoff from "@/sections/SectionScrollHandoff";
import TextImageSection from "@/sections/TextImageSection";
import TextMarqueeBanner from "@/sections/TextMarqueeBanner";
import VideoTestimonialsCarouselSection from "@/sections/VideoTestimonialsCarouselSection";

const supporterLogos = [
  { src: "/images/Mr-Beast_1.avif", alt: "MrBeast", width: 1920, height: 329 },
  { src: "/images/Trader-Joes.avif", alt: "Trader Joe's", width: 1920, height: 815 },
  { src: "/images/Pew-Logo.avif", alt: "The Pew Charitable Trusts", width: 768, height: 274 },
  { src: "/images/robin-Hood_1.avif", alt: "Robin Hood", width: 1920, height: 353 },
  { src: "/images/Beast-Philanthropy_Logo_1.avif", alt: "Beast Philanthropy", width: 1719, height: 430 },
  { src: "/images/Tony-Robbins-Foundation.avif", alt: "Tony Robbins Foundation" },
  { src: "/images/Hunts-Point-1_1.avif", alt: "Hunts Point Produce Market" },
  { src: "/images/Misfits-Market.avif", alt: "Misfits Market" },
  { src: "/images/PWPM-1.avif", alt: "Philadelphia Wholesale Produce Market" },
  { src: "/images/independence-blue-cross-logo.png", alt: "Independence Blue Cross" },
];
---

<PageLayout
  title="Sharing Excess | National Food Rescue Nonprofit"
  description="Sharing Excess rescues and distributes more than 2,000,000 lbs. of food every week in partnership with grocers, wholesalers, and farmers."
>
  <HomeHero client:visible
    title={"Rescuing Food,\n*Feeding Communities*"}
    introCaption="We rescue *over 2 million pounds* of surplus every week.\nThe food is donated; *your gift moves it*."
    introDonationForm={true}
    cardTitle={"There is more than enough food to\u00A0feed *everyone on\u00A0Earth*."}
    cardBody={"America wastes 40% of its food every year, while 47 million people go hungry.\nWe built the network to close this gap."}
    imageSrc="/images/community-people.jpg"
    imageAlt=""
    videoSrc="/videos/Website%20Sizzle-08-2026.mp4"
  />

  <TextMarqueeBanner client:visible />

  <TextImageSection client:visible
    className="relative z-10"
    theme="dark"
    layout="stack-left"
    eyebrow="The barrier isn't food supply. It's access."
    title="The food is donated; *your gift moves it*."
    body="Grocery stores, farms, and distributors generate more than they can use. Food rescue is the system that gets it to your neighbors instead of the landfill."
    headingSize="h2"
    bodySize="xl"
    primaryCta="Give Now"
    primaryCtaHref="#donate"
    secondaryCta="Give Monthly"
    secondaryCtaHref="/collective"
    imageStyle="video"
    videoSrc="/videos/wheel-two-problems.mp4"
    videoPlayInView={true}
  />

  <SectionScrollHandoff
    client:visible
    className="relative z-[11]"
    fadeFrom="dark"
    fadeTo="dark"
  >
    <MapSection client:load
      theme="dark"
      transparentBg
      layout="scroll-expand"
      headingSize="h2"
      eyebrow="Updating live, one rescue at a time."
      title="{totalLbs} pounds of food rescued since 2018. And counting."
      mapVariant="impact-clusters"
      mapCaption="Live data from Surplus app."
      primaryCta="Impact Data"
      primaryCtaHref="/about/impact"
      secondaryCta="How We Measure"
      secondaryCtaHref="https://docs.sharingexcess.com/docs/impact-measurement"
    />

    <SurplusSection client:visible
      theme="dark"
      transparentBg
      videoPosition="left"
      title="*Surplus:* the technology behind every rescue."
      body="Surplus is the platform that *powers our food rescue network*. It tracks food from pickup to delivery, connecting drivers, donors, and food access partners *in real time*."
      headingSize="h2"
      bodySize="lg"
      primaryCta="Learn more"
      primaryCtaHref="https://surplus.sharingexcess.com/"
      archBottom
    />
  </SectionScrollHandoff>

  <VideoTestimonialsCarouselSection client:load
    theme="light"
    archTop
    className="relative z-[12]"
    title="Hear directly from the *communities we serve*."
    body="Partners, volunteers, and neighbors share what rescued food means in their communities."
    headingSize="h2"
    items={[
      {
        posterSrc: "https://i.ytimg.com/vi/-6JX7-pEVrA/hqdefault.jpg",
        posterAlt: "",
        videoSrc: "https://www.youtube.com/shorts/-6JX7-pEVrA",
        caption: "Adama, Afrikana",
      },
      {
        posterSrc: "https://i.ytimg.com/vi/rBza6eJcFrU/hqdefault.jpg",
        posterAlt: "",
        videoSrc: "https://www.youtube.com/shorts/rBza6eJcFrU",
        caption: "Endang, Bethany Church",
      },
      {
        posterSrc: "https://i.ytimg.com/vi/L-4UTfPUinM/hqdefault.jpg",
        posterAlt: "",
        videoSrc: "https://www.youtube.com/watch?v=L-4UTfPUinM",
        caption: "Anthony, Volunteer",
      },
    ]}
  />

  <SectionScrollHandoff client:visible fadeFrom="light" fadeTo="green" fadeStart={0.04} fadeEnd={0.2}>
    <LogosBannerSection client:visible
      theme="light"
      transparentBg
      eyebrow="Our Supporters"
      logos={supporterLogos}
      grayscale={false}
    />

    <DonationSection client:visible
      id="donate"
      theme="light"
      transparentBg
      isCard={true}
      cardColor="kale"
      eyebrow="Support our mission"
      title="Giving $1 can provide *12 meals*."
      body="All the food we rescue is donated — your gift moves it. Every dollar goes directly toward transportation and logistics."
      headingSize="h2"
      bodySize="xl"
      formPosition="left"
      submitLabel="Donate Now"
    />
  </SectionScrollHandoff>
</PageLayout>
