---
import PageLayout from "@/layouts/PageLayout.astro";
import HomeHero from "@/sections/HomeHero";
import DonationSection from "@/sections/DonationSection";
import FormSection from "@/sections/FormSection";
import LogosBannerSection from "@/sections/LogosBannerSection";
import MapSection from "@/sections/MapSection";
import TextImageCarouselSection from "@/sections/TextImageCarouselSection";
import SectionScrollHandoff from "@/sections/SectionScrollHandoff";
import TextImageSection from "@/sections/TextImageSection";
import VideoTestimonialsCarouselSection from "@/sections/VideoTestimonialsCarouselSection";

const supporterLogos = [
  { src: "/images/Mr-Beast_1.avif", alt: "MrBeast", width: 1920, height: 329 },
  { src: "/images/Trader-Joes.avif", alt: "Trader Joe's", width: 1920, height: 815 },
  { src: "/images/Pew-Logo.avif", alt: "The Pew Charitable Trusts", width: 768, height: 274 },
  { src: "/images/robin-Hood_1.avif", alt: "Robin Hood", width: 1920, height: 353 },
  { src: "/images/Beast-Philanthropy_Logo_1.avif", alt: "Beast Philanthropy", width: 1719, height: 430 },
  { src: "/images/Tony-Robbins-Foundation.avif", alt: "Tony Robbins Foundation" },
  { src: "/images/Hunts-Point-1_1.avif", alt: "Hunts Point Produce Market" },
  { src: "/images/Misfits-Market.avif", alt: "Misfits Market" },
  { src: "/images/PWPM-1.avif", alt: "Philadelphia Wholesale Produce Market" },
  { src: "/images/independence-blue-cross-logo.png", alt: "Independence Blue Cross" },
];
---

<PageLayout
  title="Sharing Excess | National Food Rescue Nonprofit"
  description="Sharing Excess rescues and distributes more than 2,000,000 lbs. of food every week in partnership with grocers, wholesalers, and farmers."
>
  <HomeHero client:visible
    title={"Rescuing Food,\nFeeding Communities"}
    body={"We rescue 2 million pounds of surplus food every week.\nThe food is donated; your gift moves it."}
    bodySize="xl"
    imageSrc="/images/community-people.jpg"
    imageAlt=""
  />

  <TextImageSection client:visible
    className="relative z-10"
    theme="light"
    layout="stack-left"
    title={"There is more than enough food to\u00A0feed *everyone on\u00A0Earth*."}
    body="America wastes 40% of its food every year, while 47 million people go hungry. We built the network that closes that gap, rescuing surplus and moving it to communities nationwide through 2,200+ partners."
    headingSize="h2"
    bodySize="xl"
    imageStyle="video"
    imageSrc="/videos/home-hero-poster.jpg"
    videoSrc="/videos/home-hero.mp4"
    imageAlt=""
    sticker={true}
    stickerName="free-food"
    primaryCta="Donate surplus food"
    primaryCtaHref="/get-involved/partner"
    secondaryCta="Find food"
    secondaryCtaHref="/find-food"
  />

  <SectionScrollHandoff
    client:visible
    fadeFrom="light"
    fadeTo="dark"
    fadeStartVh={335}
    fadeEndVh={385}
  >
    <TextImageCarouselSection client:visible
      transparentBg
      eyebrow="Food rescue works because it's"
      items={[
        {
          title: "Free.",
          body: "Every pound we deliver is donated. Dollars fund trucks, not food.",
          imageSrc: "/images/handoff.jpg",
          imageAlt: "",
          primaryCta: "Our Financials",
          primaryCtaHref: "/about/financials",
        },
        {
          title: "Fast.",
          body: "Rescued and delivered while it's still fresh, often same-day.",
          imageSrc: "/images/truck-driver.jpg",
          imageAlt: "",
          primaryCta: "Our Model",
          primaryCtaHref: "/about",
        },
        {
          title: "Tracked.",
          body: "Every pound moves through [Surplus](https://surplus.sharingexcess.com), our platform for tracking food from pickup to delivery.",
          imageSrc: "/images/Impact-Dash.png",
          imageAlt: "",
          primaryCta: "Our Impact",
          primaryCtaHref: "/about/impact",
        },
        {
          title: "Everywhere.",
          body: "2,000+ distribution sites across 36 states.",
          imageSrc: "/images/Jul2026-ImpactMap.png",
          imageAlt: "",
          primaryCta: "Our Impact",
          primaryCtaHref: "/about/impact",
        },
      ]}
    />

    <MapSection client:visible
      theme="dark"
      transparentBg
      layout="stack-centered"
      headingSize="h2"
      eyebrow="Live from Surplus"
      title="{totalLbs} pounds of food rescued. And counting."
      mapVariant="impact-clusters"
      mapCaption="Over 2,000 distribution locations across 36 states"
      primaryCta="Impact Data"
      primaryCtaHref="/about/impact"
      secondaryCta="How We Measure"
      secondaryCtaHref="https://docs.sharingexcess.com/docs/impact-measurement"
    />
  </SectionScrollHandoff>

  <TextImageSection client:visible
    theme="dark"
    archBottom
    headingSize="h2"
    title="America throws away 40% of its food while *47 million people go hungry*."
    body="Rescuing just 7% of it would close the meal gap entirely."
    bodySize="xl"
    imageSrc="/images/problem.jpg"
    imageAlt=""
    imagePosition="right"
    imageStyle="square"
    primaryCta="Help us solve this problem"
    primaryCtaHref="/about/problem"
  />

  <VideoTestimonialsCarouselSection client:visible
    theme="light"
    archTop
    title="Hear directly from the *communities we serve*."
    headingSize="h2"
    items={[
      {
        posterSrc: "https://i.ytimg.com/vi/-6JX7-pEVrA/hqdefault.jpg",
        posterAlt: "",
        videoSrc: "https://www.youtube.com/shorts/-6JX7-pEVrA",
        caption: "Adama, Afrikana",
      },
      {
        posterSrc: "https://i.ytimg.com/vi/rBza6eJcFrU/hqdefault.jpg",
        posterAlt: "",
        videoSrc: "https://www.youtube.com/shorts/rBza6eJcFrU",
        caption: "Endang, Bethany Church",
      },
      {
        posterSrc: "https://i.ytimg.com/vi/L-4UTfPUinM/hqdefault.jpg",
        posterAlt: "",
        videoSrc: "https://www.youtube.com/watch?v=L-4UTfPUinM",
        caption: "Anthony, Volunteer",
      },
    ]}
  />

  <LogosBannerSection client:visible
    theme="light"
    eyebrow="Our Supporters"
    logos={supporterLogos}
  />

  <DonationSection client:visible
    id="donate"
    theme="light"
    isCard={true}
    cardColor="kale"
    eyebrow="Support our mission"
    title="Giving $1 can provide *12 meals*."
    body="All the food we rescue is donated — your gift moves it. Every dollar goes directly toward transportation and logistics."
    headingSize="h2"
    bodySize="lg"
    formPosition="left"
    submitLabel="Donate Now"
  />

  <FormSection client:visible
    id="newsletter"
    theme="light"
    layout="horizontal"
    headingSize="h2"
    formKind="newsletter"
    title="Subscribe to Our Newsletter."
    body="Receive a monthly update on what's happening @ Sharing Excess."
    submitLabel="Subscribe"
  />
</PageLayout>
