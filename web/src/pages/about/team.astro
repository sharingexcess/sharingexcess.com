    src: "/images/headshots/54334243555_9925fb92c7_k_1.avif",
    alt: "Diane Wilde Olcott",
    title: "Diane Wilde Olcott",
    body: "Head of Food System Advocacy",
  },
];

const programLeads = [
  {
    src: "/images/headshots/53881392250_5608b1f918_k_1.avif",
    alt: "Anne Swanson",
    title: "Anne Swanson",
    body: "Strategic Partnerships Director",
  },
  {
    src: "/images/headshots/Headshot-Mike.jpeg",
    alt: "Mike Meyer",
