---

<PageLayout
  title="Our Team | Sharing Excess"
  description="Meet the leadership and team behind Sharing Excess's national food rescue mission."
>
  <HeroSection client:visible
    layout="stack-left"
    theme="light"
    eyebrow="Our Team"
    title="Meet the crew behind the mission."
    imageSrc="/images/team.jpg"
    imageAlt=""
  />

  <TextImageSection client:visible
    theme="light"
    eyebrow="Who we are"
    title="One of the fastest-growing food rescue organizations in America"
    body="Sharing Excess is built on a simple but powerful mission: to reduce food waste through scalable and sustainable solutions. What started as a grassroots movement now operates across the country — moving nearly 2 million pounds of food every week to thousands of community partners nationwide. Our work is visionary, impactful, and deeply human."
    imageSrc="/images/IMG_9113.avif"
    imageAlt=""
    imagePosition="right"
    imageStyle="square"
  />

  <TextImageSection client:visible
    theme="dark"
    layout="three-image-caption"
    eyebrow="Our Leadership"
    headingSize="h2"
    title="Executive team"
    body="The leaders guiding Sharing Excess's growth and impact."
    images={leadership}
  />

  <TextImageSection client:visible
    theme="light"
    layout="three-image-caption"
    headingSize="h2"
    title="Program & operations leads"
    body="Regional directors and operations managers powering rescues across the country."
    images={programLeads}
  />

  <TextOnlySection client:visible
    theme="light"
    align="center"
    headingSize="h2"
    title="Join the team"
    body="We're always looking for passionate people to help end food waste and food insecurity."
    primaryCta="View Careers"
    primaryCtaHref="/get-involved/careers"
    secondaryCta="Contact Us"
    secondaryCtaHref="/contact"
  />
</PageLayout>
