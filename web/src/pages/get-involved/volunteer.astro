---
import PageLayout from "@/layouts/PageLayout.astro";
import HeroSection from "@/sections/HeroSection";
import StackingCardsSection from "@/sections/StackingCardsSection";
import TextImageSection from "@/sections/TextImageSection";

const volunteerOpportunities = [
  {
    title: "Food Rescue",
    body: "Pick up food donations from retailers, restaurants, and grocery stores. Our mobile app guides you from pickup to delivery as you collect, weigh, and transport food to nearby hunger relief organizations. Flexible and great for individuals with their own vehicle.",
    imageSrc: "/images/Screen-Shot-2023-07-12-at-3.15.20-PM_1.avif",
    imageAlt: "",
    primaryCta: "Sign Up",
    primaryCtaHref: "https://sharingexcess.vomo.org/org/sharing-excess",
  },
  {
    title: "PA Produce Gleaning",
    body: "Sort produce donations at the Philadelphia Wholesale Produce Market. Sharing Excess has rescued more than 20 million pounds of fresh produce from PWPM vendors, helping local food banks reach communities across the city. Great for individuals, teams, companies, and volunteer days!",
    imageSrc: "/images/Screen-Shot-2023-07-12-at-3.16.37-PM_1.avif",
    imageAlt: "",
    primaryCta: "Sign Up",
    primaryCtaHref: "https://sharingexcess.vomo.org/initiative/produce-sorting",
  },
  {
    title: "NYC Produce Gleaning",
    body: "Join us at the Hunts Point Produce Market in The Bronx to sort donated produce, repackage what's edible, and get it to community partners. Your help provides direct, equitable access to free, fresh produce for underserved New Yorkers. Perfect for individuals, teams, companies, and volunteer days!",
    imageSrc: "/images/unnamed_1.avif",
    imageAlt: "",
    primaryCta: "Sign Up",
    primaryCtaHref: "https://sharingexcess.vomo.org/opportunity/huntspoint",
  },
  {
    title: "Pop-Up Distribution",
    body: "Bringing free food to a neighborhood near you. Experience our iconic pop-up distributions, full of great food, good vibes, and music. Bring your friends and join the movement, perfect for groups and individuals alike.",
    imageSrc: "/images/__DSC_0380-5_1.avif",
    imageAlt: "",
    primaryCta: "Sign Up",
    primaryCtaHref: "https://sharingexcess.vomo.org/opportunity/west-philly-pop-up-food-distribution",
  },
  {
    title: "Sharehouse Saturdays",
    body: "Located in West Philly, the Sharehouse is our hub for weekend distributions. Join us packing home deliveries, moving pallets, and loading up partners for pickup. Great for individuals and small groups!",
    imageSrc: "/images/Screen-Shot-2023-07-12-at-3.25.36-PM_1.avif",
    imageAlt: "",
    primaryCta: "Sign Up",
    primaryCtaHref: "https://sharingexcess.vomo.org/opportunity/packing-and-loading-at-the-sharehouse",
  },
];
---

<PageLayout
  title="Volunteer with Sharing Excess | Food Rescue Opportunities"
  description="Join hundreds of volunteers helping Sharing Excess bridge the gap between food excess and scarcity."
>
  <HeroSection client:visible
    layout="stack-left"
    theme="light"
    eyebrow="Volunteer"
    title="Our passionate *volunteers* make our mission possible."
    imageSrc="/images/freefood-volunteer.jpg"
    imageAlt=""
    imageObjectPosition="top"
    imageAspect="2047 / 1365"
    sticker={true}
    className="!bg-se-green-100 [--section-text:var(--color-kale)] [--section-emphasis:var(--color-se-green-base)]"
  />

  <TextImageSection client:visible
    theme="dark"
    dotShimmer
    headingSize="h2"
    title="Powered by People"
    body="Sharing Excess runs on hundreds of dedicated volunteers bridging the gap between food excess and scarcity. Whether you're driving, distributing at pop-ups, or sorting donations, you'll make a real impact while having fun. Join us and be part of the solution today!"
    imageSrc="/images/20230407_PWPM_215.avif"
    imageAlt=""
    imagePosition="right"
    imageStyle="square"
    primaryCta="Sign Up to Volunteer"
    primaryCtaHref="https://sharingexcess.vomo.org/org/sharing-excess"
    primaryCtaTarget="_blank"
  />

  <StackingCardsSection client:visible
    theme="light"
    heading="Available Opportunities"
    items={volunteerOpportunities}
  />

  <TextImageSection client:visible
    theme="dark"
    className="!bg-kale"
    eyebrow="Have a skill that you think can help our mission?"
    headingSize="h2"
    title="Share your *talent*"
    body="From graphic design to event planning, marketing to photography, outreach to fundraising, your talents can help us amplify our mission and make a real difference in the fight against food waste and hunger. Volunteer your talent and let your skills shine for a cause that truly matters. Let us know how you can help, or ask us what areas we could use help in!"
    imageSrc="/images/Screen-Shot-2023-07-12-at-3.28.30-PM_1.avif"
    imageAlt=""
    imagePosition="left"
    imageStyle="square"
    primaryCta="Reach Out"
    primaryCtaHref="/contact"
  />
</PageLayout>
