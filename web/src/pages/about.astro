---
import PageLayout from "@/layouts/PageLayout.astro";
import { getInstagramFeed, SOCIAL_MEDIA_FALLBACK_ITEMS } from "@/lib/instagram";
import HeroSection from "@/sections/HeroSection";
import SocialMediaSection from "@/sections/SocialMediaSection";
import TextImageSection from "@/sections/TextImageSection";

const instagramItems = await getInstagramFeed(4);
const socialItems = instagramItems ?? SOCIAL_MEDIA_FALLBACK_ITEMS;
---

<PageLayout
  title="About Sharing Excess | Innovative Food Rescue Nonprofit"
  description="Learn how Sharing Excess rescues surplus food and delivers it to communities in need."
>
  <HeroSection
    layout="full-width"
    title={"About Sharing\nExcess"}
    imageSrc="/images/oranges.jpg"
    imageAlt=""
    primaryCta="Get involved"
    primaryCtaHref="/get-involved"
    secondaryCta="Contact us"
    secondaryCtaHref="/contact"
  />
  <TextImageSection
    theme="light"
    title="Food rescue at scale"
    body="Sharing Excess coordinates volunteers, logistics, and partnerships to move fresh food quickly from where it is surplus to where it is needed."
    imageSrc="/images/financials.jpg"
    imageAlt="Sharing Excess team distributing food"
    imagePosition="right"
    imageStyle="square"
  />
  <SocialMediaSection
    theme="light"
    title="Keep up with us on Instagram 👋"
    headingSize="h2"
    items={socialItems}
    showNavigation={false}
    highlightedIndex={1}
  />
</PageLayout>
