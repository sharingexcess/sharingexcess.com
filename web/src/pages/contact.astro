---
import PageLayout from "@/layouts/PageLayout.astro";
import FormSection from "@/sections/FormSection";
import HeroSection from "@/sections/HeroSection";
---

<PageLayout
  title="Contact Sharing Excess"
  description="Get in touch with Sharing Excess about partnerships, volunteering, or food rescue."
>
  <HeroSection
    theme="dark"
    title="Contact us"
    body="Questions about donating food, volunteering, or partnering with Sharing Excess? We'd love to hear from you."
  />
  <FormSection
    variant="white"
    layout="horizontal-card"
    title="Send a message"
    body="Form integration will be wired during the next migration wave."
  />
</PageLayout>
